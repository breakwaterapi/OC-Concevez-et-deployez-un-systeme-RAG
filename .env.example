# === Required ===
MISTRAL_API_KEY=your_key_here

# === Required to call POST /rebuild (sent as header X-API-Key) ===
REBUILD_API_KEY=change-me

# === Mistral models (optional — defaults below) ===
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_TEMPERATURE=0.3

# === RAG settings (optional) ===
RETRIEVAL_K=5
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP_TOKENS=20
REFERENCE_DATE=2026-06-01

# === OpenAgenda (optional) ===
OPENAGENDA_REGION=Île-de-France
# Passez à 10000 pour construire l'index de démo réel avec la couverture maximale
OPENAGENDA_MAX_RECORDS=1000

# === UI (optional) ===
# Use http://api:8000 when running with docker-compose
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30
