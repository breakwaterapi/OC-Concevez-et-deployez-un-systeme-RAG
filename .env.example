# === Required ===
MISTRAL_API_KEY=your_key_here

# === Required to call POST /rebuild (sent as header X-API-Key) ===
REBUILD_API_KEY=change-me

# === Mistral models (optional — defaults below) ===
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_TEMPERATURE=0.3
MISTRAL_TIMEOUT_S=30

# === RAG settings (optional) ===
RETRIEVAL_K=5
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP_TOKENS=20
REFERENCE_DATE=2026-06-01

# === OpenAgenda (optional) ===
OPENAGENDA_REGION=Île-de-France
# 1000 est la couverture maximale pratique pour ce filtre région + fenêtre temporelle
# (limite d'offset de l'API OpenAgenda pour ce type de requête)
OPENAGENDA_MAX_RECORDS=1000

# === UI (optional) ===
# Use http://api:8001 when running with docker-compose
API_BASE_URL=http://localhost:8001
API_TIMEOUT=30
